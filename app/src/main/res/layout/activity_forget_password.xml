<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ForgetPassword"
    android:orientation="vertical"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/forget_pass_pic"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/Forget_Password_Text"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginLeft="20dp"

        android:layout_marginRight="20dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/linear_round_shape"
        android:elevation="3dp"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/Medicine_Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="115dp"
            android:paddingTop="5dp"
            android:text="Forget Password"
            android:textAlignment="center"
            android:textColor="@color/text_color"
            android:textSize="17sp"
            android:textStyle="bold"
            />

        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="vertical"

        >

        <TextView
            android:id="@+id/EmailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textStyle="bold"
            android:textSize="22sp"
            android:paddingLeft="40dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/curve_color"
            />

        <EditText
            android:id="@+id/edit_EmailF_text"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:ems="30"
            android:inputType="textPersonName"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:paddingRight="32dp"
            android:hint="Enter Email"
            android:layout_marginTop="10dp"
            android:textSize="18sp"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"
            />
        <TextView
            android:id="@+id/login_go_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login to your account"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingLeft="50dp"
            android:layout_marginTop="15dp"
            android:textColor="@color/curve_color"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/Submit_Btnz"
            style="@android:style/Widget.Button"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:background="@drawable/background_btn"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="32dp"
            android:text="Submit"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="35dp"
            android:drawableEnd="@drawable/circle"
            android:paddingStart="45dp"
            />


    </LinearLayout>

</LinearLayout>