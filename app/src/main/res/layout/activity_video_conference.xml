<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VideoConference"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:orientation="vertical"
        android:background="@drawable/video_conference_picz"
        android:layout_marginLeft="65dp"
        android:layout_marginTop="40dp"
        >
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="20dp"
        android:id="@+id/Forget_Password_Text"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginLeft="20dp"

        android:layout_marginRight="20dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/linear_round_shape"
        android:elevation="3dp"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/joinConference_Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="90dp"
            android:paddingTop="5dp"
            android:text="Join Video Conference"
            android:textAlignment="center"
            android:textColor="@color/text_color"
            android:textSize="17sp"
            android:textStyle="bold"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:orientation="vertical"

        >

        <TextView
            android:id="@+id/SecurityCode_Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Security Code"
            android:textStyle="bold"
            android:textSize="22sp"
            android:paddingLeft="95dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/curve_color"
            />

        <EditText
            android:id="@+id/edit_SecurityCode_text"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:ems="30"
            android:inputType="textPersonName"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:paddingRight="32dp"
            android:hint="Enter Code"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:textSize="18sp"
            android:gravity="center"
            android:textAlignment="center"
            android:background="@drawable/edit_text_background"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/Join_Btnz"
            style="@android:style/Widget.Button"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:background="@drawable/background_btn"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="32dp"
            android:text="Join"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:drawableEnd="@drawable/circle"
            android:paddingStart="45dp"
            />

    </LinearLayout>


</LinearLayout>